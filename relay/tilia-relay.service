[Unit]
Description=Tilia candle relay (in-memory mailbox, stdlib only)
After=network.target

[Service]
# Secrets are never in this file: put them in /etc/tilia-relay.env (mode 600):
#   TILIA_RELAY_MACS=<id>:<sha256hex>[,<id>:<sha256hex>]
#   TILIA_RELAY_ORIGINS=<optional dev origin>
#   TILIA_RELAY_TRUST_PROXY=1     (set when Caddy or a tunnel is in front)
#   PORT=8787
EnvironmentFile=/etc/tilia-relay.env
ExecStart=/usr/bin/python3 /opt/tilia-relay/tilia_relay.py
DynamicUser=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
